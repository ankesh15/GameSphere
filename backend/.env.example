# GameSphere Backend Environment Configuration Example

# Database Connection (MongoDB)
MONGODB_URI=mongodb://localhost:27017/gamesphere

# JWT Authentication Configuration
JWT_SECRET=your_jwt_secret_at_least_16_chars_long
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your_jwt_refresh_secret_at_least_16_chars_long
JWT_REFRESH_EXPIRES_IN=7d

# Microservice Integration (AI Service)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=
AI_TIMEOUT_MS=4000
AI_CACHE_TTL_SECONDS=300
AI_CACHE_MAX=500

# Rate Limiting & Error Tracking
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120
ERROR_TRACKING_DSN=
